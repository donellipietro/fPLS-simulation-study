#!/usr/bin/env bash
set -euo pipefail

: "${PBS_JOBID:?This script must run inside one Torque/PBS job}"
: "${PBS_O_WORKDIR:?PBS_O_WORKDIR is not set}"
: "${KAMI_RUN_DIR:?KAMI_RUN_DIR is not set; submit with scripts/submit_kami_review.sh}"
: "${PBS_MULTI_CPUS:?PBS_MULTI_CPUS is not set}"

cd "${PBS_O_WORKDIR}"
if [[ ! -f Makefile || ! -x tests/run_tests.sh ]]; then
  echo "Error: submit the job from the fPLS-simulation-study repository root." >&2
  exit 1
fi
mkdir -p "${KAMI_RUN_DIR}"

CURRENT_STAGE="startup"
STARTED_AT="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
finish() {
  local status=$?
  trap - EXIT
  {
    printf 'job_id=%s\n' "${PBS_JOBID}"
    printf 'status=%s\n' "$([[ "${status}" -eq 0 ]] && printf success || printf failed)"
    printf 'last_stage=%s\n' "${CURRENT_STAGE}"
    printf 'started_at=%s\n' "${STARTED_AT}"
    printf 'finished_at=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    printf 'git_commit=%s\n' "$(git rev-parse HEAD 2>/dev/null || printf unknown)"
  } > "${KAMI_RUN_DIR}/final_status.txt"
  exit "${status}"
}
trap finish EXIT

if [[ -n "${PBS_NODEFILE:-}" && -r "${PBS_NODEFILE}" ]]; then
  ALLOCATED_SLOTS="$(wc -l < "${PBS_NODEFILE}" | tr -d '[:space:]')"
  if [[ "${ALLOCATED_SLOTS}" =~ ^[0-9]+$ ]] &&
      (( ALLOCATED_SLOTS < PBS_MULTI_CPUS )); then
    echo "Error: PBS allocated ${ALLOCATED_SLOTS} slots, fewer than requested ${PBS_MULTI_CPUS}." >&2
    exit 1
  fi
fi

export OMP_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export VECLIB_MAXIMUM_THREADS=1

printf 'Reviewer campaign job: %s\nHost: %s\nStarted: %s\n' \
  "${PBS_JOBID}" "$(hostname)" "${STARTED_AT}"

CURRENT_STAGE="build"
make --no-print-directory build PROFILE=hpc-torque

CURRENT_STAGE="compile_all"
make --no-print-directory compile_all PROFILE=hpc-torque \
  COMPILE_STRATEGY=local COMPILE_JOBS="${PBS_MULTI_CPUS}"

for suite in 1D 2D GCV 2D-predictive-order; do
  CURRENT_STAGE="${suite}/all"
  printf '\n===== Running %s/all serially =====\n' "${suite}"
  ./tests/run_tests.sh "${suite}" all
done

CURRENT_STAGE="review_tables"
make --no-print-directory review_tables

CURRENT_STAGE="complete"
printf '\nReviewer campaign completed successfully.\n'
